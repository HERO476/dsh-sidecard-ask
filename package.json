{
  "name": "dsh-sidecard-ask",
  "version": "1.5.0",
  "description": "DSH 划词追问（侧边卡片作答）：在聊天区与任务区选中文本就地追问，答案由独立子代理在侧边卡片里流式呈现，也可选择落回主对话。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "selection",
    "划词",
    "选中追问",
    "ask",
    "side-card",
    "侧边卡片"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HERO476/dsh-sidecard-ask.git"
  },
  "homepage": "https://github.com/HERO476/dsh-sidecard-ask#readme",
  "bugs": {
    "url": "https://github.com/HERO476/dsh-sidecard-ask/issues"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "侧边卡片追问",
    "description": "选中聊天或任务里的文本就地追问；答案由独立子代理在侧边卡片里流式呈现（也可落回主对话）。"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
