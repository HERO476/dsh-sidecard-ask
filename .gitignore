# Dependencies and build residue (this package ships plain JavaScript on purpose)
node_modules/
*.log
*.tmp

# Compat probe: downloaded tarballs and raw results (regenerate with tools/compat-probe.mjs)
tools/.cache/

# Local scratch
.tmp/
tmp-*.mjs

# Local agent work journal (not part of the plugin; the repo owner keeps it out of git)
.workbuddy/
.workbuddy-ai/

# Local third-party tool residue (graphflow / mnemon indexes, never part of the plugin)
.graphflow/
.graphflow-cache/
.mnemon/
graphflow-out/

# Windows ACL recovery backups written by a local tool (never part of the plugin)
.acl-recovery/
